{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/execution/layout,_N_T_/dashboard/execution/page,_N_T_/dashboard/execution"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/execution/__PAGE__",
    "/dashboard/execution",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}